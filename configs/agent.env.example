ATLAS_SERVER_URL=https://atlas.example.com
ATLAS_NODE_NAME=Tokyo-02
ATLAS_ENROLLMENT_TOKEN=replace-with-single-use-token
ATLAS_AGENT_STATE_PATH=/var/lib/nginx-atlas/agent.json
ATLAS_NGINX_CONFIG_DIR=/etc/nginx/conf.d
ATLAS_SSL_ROOT=/etc/ssl
ATLAS_DATA_ROOT=/var/lib/nginx-atlas
ATLAS_POLL_INTERVAL=10s
# Set tcp4 only when the controller's IPv6 path is unreliable.
ATLAS_CONTROLLER_NETWORK=auto
