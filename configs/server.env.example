# Bind the controller to loopback and publish it through an HTTPS reverse proxy.
ATLAS_ADDR=127.0.0.1:9090
ATLAS_PUBLIC_URL=https://atlas.example.com
ATLAS_STATE_PATH=/var/lib/nginx-atlas/state.json

# Generate with: atlas generate-secrets
ATLAS_MASTER_KEY=replace-with-generated-base64url-key
ATLAS_ADMIN_TOKEN=replace-with-generated-admin-token
